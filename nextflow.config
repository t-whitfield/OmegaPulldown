/*
 * =========================================================================
 * OmegaPulldown configuration
 * =========================================================================
 *
 *  Adapt the profiles and resource labels to your compute environment.
 *  At minimum, set:
 *    --baits_fasta, --candidates_fasta, --mmseqs_db (if not using msa server)
 */

params {
    // Input 
    baits_fasta      = "${projectDir}/inputs/sequences/baits.fasta"
    candidates_fasta = "${projectDir}/inputs/sequences/candidates.fasta"
    self_pairs       = false   // Include self-pairs (A vs A)?

    // Post-translational modifications (optional) 
    // CSV format: protein_id,position,ccd
    // If null, the pipeline looks for bait_ptms.csv / candidate_ptms.csv
    // alongside each FASTA file.
    // If neither exists, the pipeline runs without modifications (default).
    bait_ptms      = null // Path to bait PTMs CSV, or null for auto-detect
    candidate_ptms = null // Path to candidate PTMs CSV, or null for auto-detect

    // Output 
    outdir          = 'results'

    // Predictor selection 
    // 'boltz2' or 'alphafold3'
    predictor       = 'boltz2'

    // Pre-computed alignments 
    // Path to directory containing a3m/ and csv/ subdirectories.
    // If A3M files exist here for a protein, MMSEQS_SEARCH is skipped for
    // that protein.
    alignments_dir  = "${projectDir}/results/alignments"

    // MSA strategy 
    // true  = let Boltz-2 fetch MSAs from MMseqs2 server (simpler, slower
    // for large screens)
    // false = pre-compute MSAs locally with mmseqs2 (faster, requires local DB)
    use_msa_server  = false
    msa_server_url  = 'https://api.colabfold.com'  // only used if use_msa_server=true

    // MMseqs2 parameters (local MSA mode) 
    mmseqs_db           = '/path/to/mmseqs2/UniRef90'    // Path to MMseqs2 database (e.g., UniRef30 or UniRef90)
    mmseqs_iterations   = 3     // Number of search iterations (profile search)
    mmseqs_sensitivity  = 7.5   // Search sensitivity (-s flag)
    mmseqs_evalue       = 0.001 // E-value threshold
    max_msa_seqs        = 8192  // Max MSA sequences retained per protein

    //  Conda environment for Boltz-2 
    conda_init = '/path/to/miniconda3/bin/conda'        // Path to conda executable
    boltz_env  = 'boltz2'                              // Name of conda environment with Boltz-2

    //  Boltz-2 prediction parameters 
    recycling_steps   = 3
    sampling_steps    = 200
    diffusion_samples = 5
    step_scale        = 1.638
    use_potentials    = true  // Enable Boltz-Steering physics-based potentials

    //  AlphaFold 3 parameters 
    af3_sif       = '/path/to/alphafold3.sif'             // Singularity image
    af3_db_dir    = '/path/to/alphafold3-databases'      // Genetic databases
    af3_model_dir = '/path/to/alphafold3-weights'        // Model parameters
    af3_seeds     = '42,43,44,45,46'             // Comma-separated model seeds
    af3_samples   = 1                           // Diffusion samples per seed

    // Ranking
    // options: protein_iptm, iptm, pdockq, confidence_score, complex_plddt
    rank_by = 'protein_iptm'
}

// Process resource labels 
process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = '4GB'
    }
    withLabel: 'process_medium' {
        cpus   = 16
        memory = '256GB'
    }
    withLabel: 'process_gpu' {
        cpus          = 8
        memory        = '240GB'
    }
}

// Execution profiles 
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        executor {
            name            = 'slurm'
            queueSize       = 100
            submitRateLimit = '10 sec'
	    exitReadTimeout = '10 min'
        }
        process.queue    = '20,24'
        process {
            withLabel: 'process_medium' {
                cpus   = 16
                memory = '256GB'
		clusterOptions = '--partition=20,24'
            }
            withLabel: 'process_gpu' {
	        cpus          = 8
        	memory        = '240GB'
                clusterOptions = '--gres=gpu:1 --partition=nvidia-A100-20,nvidia-A6000-20'
            }
        }
    }

    sge {
        process.executor = 'sge'
        process {
            withLabel: 'process_gpu' {
                clusterOptions = '-l gpu=1'
            }
        }
    }

    // Conda environment with boltz, mmseqs2, python dependencies
    conda {
        process.conda = "${projectDir}/environment.yml"
    }

    // Singularity container (build your own with boltz2 + mmseqs2)
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        // process.container = '/path/to/boltz2-pulldown.sif'
    }

    // Quick test with the sequences in results/sequences/
    test {
        params.baits_fasta      = "${projectDir}/inputs/sequences/baits.fasta"
        params.candidates_fasta = "${projectDir}/inputs/sequences/candidates.fasta"
        params.use_msa_server   = false
        params.sampling_steps   = 20
        params.recycling_steps  = 1
    }
}

// Nextflow execution settings 
timeline {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
dag {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
