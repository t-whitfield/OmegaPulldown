/*
 * =========================================================================
 * OmegaPulldown configuration
 * =========================================================================
 *
 *  Adapt the profiles and resource labels to your compute environment.
 *  At minimum, set:
 *    --baits_fasta, --candidates_fasta
 *    --boltz2_uniref30_db, --taxonomy_rdb (predictor=boltz2, local MSA mode
 *    only)
 */

params {
    // Input 
    baits_fasta      = "${projectDir}/inputs/sequences/baits.fasta"
    candidates_fasta = "${projectDir}/inputs/sequences/candidates.fasta"
    self_pairs       = false   // Include self-pairs (A vs A)? Cross-product mode only.

    // Pair-list input (optional). When pairs_tsv is set, baits_fasta/
    // candidates_fasta are ignored and ONLY the pairs named in that file are
    // predicted; sequences come from sequences_fasta, which must hold every
    // protein the list references. The first two columns are the protein IDs
    // (a header row is auto-detected).
    pairs_tsv       = null
    sequences_fasta = null

    // Post-translational modifications (optional)
    //
    // ONE ID-keyed table for the whole run, conventionally ptms.tsv:
    //   protein_id<TAB>position<TAB>ccd
    // Tab- or comma-separated (sniffed). If null, the pipeline looks for
    // ptms.tsv then ptms.csv beside the FASTA that defines this run's
    // proteins (sequences_fasta in pair-list mode, baits_fasta otherwise).
    // If neither exists, the run proceeds with no modifications.
    ptms = null


    // Output 
    outdir          = 'results'

    // Predictor selection 
    // 'boltz2' or 'alphafold3'
    predictor       = 'boltz2'

    // Pre-computed alignments, split per folding backend.
    // Boltz-2 and AF3 were trained on different MSA lineages
    // (ColabFold-search vs. AF3-native jackhmmer/hhblits-equivalent.
    // The two directories do NOT have the same layout, because the two
    // predictors cache different content:
    //   alignments_dir_af3/a3m/<id>.a3m          unpaired MSA
    //   alignments_dir_af3/paired_a3m/<id>.paired.a3m   paired MSA
    //                                            (checked independently)
    //   alignments_dir_boltz2/csv/<id>.csv       taxonomy-tagged CSV
    // Boltz-2 has no a3m/ level: taxonomy tagging happens in the same task
    // as the search, so no intermediate a3m is worth caching on its own.
    // If a protein exists here, its MSA search is skipped.
    alignments_dir_af3    = "${projectDir}/results/alignments_af3"
    alignments_dir_boltz2 = "${projectDir}/results/alignments_boltz2"

    // MSA strategy
    // true  = let Boltz-2 fetch MSAs from the public ColabFold API (simpler,
    //         no local DB required, but depends on a public service staying
    //         up/responsive and un-rate-limited)
    // false = pre-compute MSAs locally (MSA_SEARCH_DB_BOLTZ2, taxonomy-ID
    //         join, see modules/search_msa_boltz2.nf), no public API
    //         dependency, but pays a large, mostly-fixed UniRef30-index-load
    //         cost per batch before any GPU prediction can start.
    use_msa_server  = true
    msa_server_url  = 'https://api.colabfold.com'  // only used if use_msa_server=true

    boltz2_uniref30_db = '/path/to/mmseqs2/UniRef30'
    boltz2_envdb_db    = '/path/to/mmseqs2/ColabFold_Env'
    
    // Searching environmental DBs works, but is not recommended due to
    // prohibitive computational expense on all but the most capable resources.
    use_env = false
    boltz2_mmseqs_sensitivity = 8
    boltz2_mmseqs_evalue      = 0.1
    mmseqs_iterations   = 3     // Number of search iterations (profile search), boltz2-only, AF3-native's own recipe is single-pass (no iteration param).
    mmseqs_sensitivity  = 7.5   // Search sensitivity (-s flag) for the AF3-native DBs below. NOT used by boltz2.
    max_msa_seqs        = 8192  // Max MSA sequences retained per protein (boltz2 CSV output).

    // Batch size for MSA_SEARCH_DB_BOLTZ2: number of proteins
    // searched together in one mmseqs2 invocation, same rationale as
    // af3_native_batch_size below: amortize the large UniRef30 index load
    // (and the taxonomy.rdb load, see below) across many proteins instead of
    // paying it once per protein. Kept as a separate param from
    // af3_native_batch_size since the DB-load economics differ between the
    // two predictors' searches. Conservative starting default.
    boltz2_batch_size = 10

    // Real taxonomy.rdb from the Boltz-2 developers.
    // Loaded into a local, per-batch redis-server by MSA_SEARCH_DB_BOLTZ2.
    taxonomy_rdb = '/path/to/mmseqs2/taxonomy.rdb'
    taxonomy_env = 'rdbenv'  // conda env with rdbtools/redis/redis-server.

    // AF3-native MSA databases (predictor=alphafold3 only):
    // three independent per-database mmseqs2 searches (UniRef90,
    // MGnify, Small BFD) at AF3's native e-value and max_sequences defaults.
    af3_native_evalue     = 0.0001  // AF3-native default (1e-4)

    // Conservative starting default.
    af3_native_batch_size = 10

    af3_native_dbs = [
        [name: 'uniref90', path: '/path/to/mmseqs2/UniRef90_2022_05', max_seqs: 10000, split: 16],
        [name: 'mgnify',   path: '/path/to/mmseqs2/MGnify',     max_seqs: 5000,  split: 16],
        [name: 'bfd',      path: '/path/to/mmseqs2/BFD', max_seqs: 5000,  split: 8],
    ]
    
    af3_native_uniprot_db = [name: 'uniprot', path: '/path/to/mmseqs2/UniProt2021', max_seqs: 50000, split: 8]

    //  Conda environment for Boltz-2 
    conda_init = '/path/to/miniconda3/bin/conda'  // Path to conda executable
    boltz_env  = 'boltz2'  // Name of conda environment with Boltz-2

    //  Boltz-2 prediction parameters 
    recycling_steps   = 3
    sampling_steps    = 200
    diffusion_samples = 5
    step_scale        = 1.638
    use_potentials    = true  // Enable Boltz-Steering physics-based potentials

    //  AlphaFold 3 parameters 
    af3_sif       = '/path/to/alphafold3_20260324.sif'   // Singularity image
    af3_db_dir    = '/path/to/alphafold3-databases'      // Genetic databases
    af3_model_dir = '/path/to/alphafold3-weights'        // Model parameters
    af3_seeds     = '42,43,44,45,46'             // Comma-separated model seeds
    af3_samples   = 1                            // Diffusion samples per seed

    // The default setting for assigning CPU-only jobs to the scheduler.
    // null means "name no partition", nextflow omits -p and the slurm
    // scheduler places the job on any partition flagged with Default=YES.
    // Fails on a cluster with no such setting. Tune to a reasonable list
    // of partitions.
    cpu_partition = null

    // GPU tiers for escalate-on-retry (site-specific; consumed ONLY by the
    // slurm profile below, never by a module). Modules declare the label
    // 'process_gpu' and know nothing about partitions -- that separation is
    // what lets the sge profile map the same label to '-l gpu=1'.
    //
    // gpu_partition       : where a GPU task runs on its first attempt.
    // gpu_partition_large : where it is re-tried after a failure, normally a
    //                       bigger-VRAM tier. Set to null to disable
    //                       escalation entirely: every attempt then uses
    //                       gpu_partition, i.e. the previous behaviour. Sites
    //                       with a single GPU tier should leave it null.

    // Set this or the job goes to the default node type, which on most
    // HPC clusters has no GPUs, and the job can pend indefinitely. null is
    // a a working option only on a homegeneous all-GPU cluster.
    gpu_partition       = null

    // For HPC environments with a single GPU tier, leave this null.
    // Otherwise, specify the more capable GPU partition(s) here.
    gpu_partition_large = null

    // Ranking
    // options: protein_iptm, iptm, pdockq, confidence_score, complex_plddt
    rank_by = 'protein_iptm'
}

// Process resource labels
process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 1
        memory = '4GB'
    }
    withLabel: 'process_medium' {
        cpus   = 16
        memory = '128GB'
    }
    withLabel: 'process_gpu' {
        cpus          = 8
        memory        = '240GB'
    }
    withLabel: 'process_mmseqs_large' {
        cpus   = 16
        memory = '240GB'
    }
    withLabel: 'process_mmseqs_bigmem' {
        cpus   = 16
        memory = '800GB'
    }
}

// Execution profiles 
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        executor {
            name            = 'slurm'
            queueSize       = 150
            submitRateLimit = '10 sec'
	    exitReadTimeout = '6h'
        }
        process.queue = { params.cpu_partition }
        process {
            withLabel: 'process_medium' {
                cpus   = 16
                memory = '128GB'
            }
            withLabel: 'process_gpu' {
	        cpus          = 8
        	memory        = '240GB'
                queue = null
                clusterOptions = {
                    def part = (task.attempt > 1 && params.gpu_partition_large)
                             ? params.gpu_partition_large
                             : params.gpu_partition
                    part ? "--gres=gpu:1 --partition=${part}" : "--gres=gpu:1"
                }
            }
            withLabel: 'process_mmseqs_large' {
                cpus   = 16
                memory = '240GB'
            }
            withLabel: 'process_mmseqs_bigmem' {
                cpus   = 16
                memory = '800GB'
            }
        }
    }

    // SGE scheduler (optional, tailor to your own scheduler)
    sge {
        process.executor = 'sge'
        process {
            withLabel: 'process_gpu' {
                clusterOptions = '-l gpu=1'
            }
        }
    }


    // Quick test with the sequences in inputs/sequences/ (the actin toy set:
    // one bait, four candidates, one of which is a true binder).
    test {
        params.baits_fasta      = "${projectDir}/inputs/sequences/baits.fasta"
        params.candidates_fasta = "${projectDir}/inputs/sequences/candidates.fasta"
        params.use_msa_server   = true
        params.sampling_steps   = 20
        params.recycling_steps  = 1
    }
}

// Nextflow execution settings 
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
timeline {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
dag {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}

// Pipeline metadata
manifest {
    name            = 'OmegaPulldown'
    author          = 'Troy Whitfield'
    homePage        = 'https://github.com/t-whitfield/OmegaPulldown'
    description     = 'Structure-based protein-protein interaction screening with Boltz-2 and AlphaFold 3'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    version         = '1.0.0'
    license         = 'MIT'
    nextflowVersion = '>=23.04.0'
}

