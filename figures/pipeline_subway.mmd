%%metro line: boltz2 | Boltz-2 path | #1baf7a
%%metro line: af3 | AlphaFold 3 path | #2a78d6
%%metro line: msa_server | use_msa_server bypass (Boltz-2 only) | #1baf7a | dashed
%%metro line: openfold3 | OpenFold3 (planned, not yet implemented) | #4a3aa7 | dotted
%%metro file: baits_in | baits.fasta
%%metro file: candidates_in | candidates.fasta
%%metro file: bait_ptms_in | bait_ptms.csv (optional)
%%metro file: cand_ptms_in | candidate_ptms.csv (optional)
%%metro off_track: bait_ptms_in, cand_ptms_in
%%metro file: rankings_out | rankings_{predictor}.tsv
%%metro legend: bl
%%metro process: GENERATE_PAIRS | GENERATE_PAIRS
%%metro process: MMSEQS_SEARCH | MMSEQS_SEARCH
%%metro process: A3M_TO_BOLTZ_CSV | A3M_TO_BOLTZ_CSV
%%metro process: MAKE_BOLTZ_YAML | MAKE_BOLTZ_YAML
%%metro process: MAKE_BOLTZ_YAML_NO_MSA | MAKE_BOLTZ_YAML_NO_MSA
%%metro process: BOLTZ_PREDICT | BOLTZ_PREDICT
%%metro process: PARSE_METRICS | PARSE_METRICS
%%metro process: MAKE_AF3_JSON | MAKE_AF3_JSON
%%metro process: AF3_PREDICT | AF3_PREDICT
%%metro process: PARSE_METRICS_AF3 | PARSE_METRICS_AF3
%%metro process: RANK_PREDICTIONS | RANK_PREDICTIONS

graph LR
    subgraph input [Input & pairing]
        %%metro exit: right | boltz2, af3, openfold3
        %%metro exit: bottom | msa_server
        baits_in[ ]
        candidates_in[ ]
        bait_ptms_in[ ]
        cand_ptms_in[ ]
        GENERATE_PAIRS[GENERATE_PAIRS]
        MMSEQS_SEARCH[MMSEQS_SEARCH]

        baits_in -->|boltz2,af3,openfold3| GENERATE_PAIRS
        candidates_in -->|boltz2,af3,openfold3| GENERATE_PAIRS
        GENERATE_PAIRS -->|boltz2,af3,openfold3| MMSEQS_SEARCH
    end

    subgraph boltz2_path [Boltz-2 prediction]
        %%metro entry: left | boltz2
        %%metro entry: top | msa_server
        %%metro exit: right | boltz2
        A3M_TO_BOLTZ_CSV[A3M_TO_BOLTZ_CSV]
        MAKE_BOLTZ_YAML[MAKE_BOLTZ_YAML]
        MAKE_BOLTZ_YAML_NO_MSA[MAKE_BOLTZ_YAML_NO_MSA]
        BOLTZ_PREDICT[BOLTZ_PREDICT]
        PARSE_METRICS[PARSE_METRICS]

        A3M_TO_BOLTZ_CSV -->|boltz2| MAKE_BOLTZ_YAML
        MAKE_BOLTZ_YAML -->|boltz2| BOLTZ_PREDICT
        MAKE_BOLTZ_YAML_NO_MSA -->|msa_server| BOLTZ_PREDICT
        BOLTZ_PREDICT -->|boltz2,msa_server| PARSE_METRICS
    end

    subgraph af3_path [AlphaFold 3 prediction]
        %%metro entry: left | af3
        %%metro exit: right | af3
        MAKE_AF3_JSON[MAKE_AF3_JSON]
        AF3_PREDICT[AF3_PREDICT]
        PARSE_METRICS_AF3[PARSE_METRICS_AF3]

        MAKE_AF3_JSON -->|af3| AF3_PREDICT
        AF3_PREDICT -->|af3| PARSE_METRICS_AF3
    end

    subgraph openfold3_path [OpenFold3 prediction - planned]
        %%metro entry: left | openfold3
        %%metro exit: right | openfold3
        OPENFOLD3_PREDICT[OPENFOLD3_PREDICT]
        PARSE_METRICS_OF3[PARSE_METRICS_OF3]

        OPENFOLD3_PREDICT -->|openfold3| PARSE_METRICS_OF3
    end

    subgraph ranking [Ranking]
        %%metro entry: left | boltz2, af3, openfold3
        RANK_PREDICTIONS[RANK_PREDICTIONS]
        rankings_out[ ]

        RANK_PREDICTIONS -->|boltz2,af3,openfold3| rankings_out
    end

    %% Inter-section edges
    MMSEQS_SEARCH -->|boltz2| A3M_TO_BOLTZ_CSV
    MMSEQS_SEARCH -->|af3| MAKE_AF3_JSON
    MMSEQS_SEARCH -->|openfold3| OPENFOLD3_PREDICT
    GENERATE_PAIRS -->|msa_server| MAKE_BOLTZ_YAML_NO_MSA
    bait_ptms_in -->|boltz2| MAKE_BOLTZ_YAML
    bait_ptms_in -->|af3| MAKE_AF3_JSON
    cand_ptms_in -->|boltz2| MAKE_BOLTZ_YAML
    cand_ptms_in -->|af3| MAKE_AF3_JSON
    PARSE_METRICS -->|boltz2| RANK_PREDICTIONS
    PARSE_METRICS_AF3 -->|af3| RANK_PREDICTIONS
    PARSE_METRICS_OF3 -->|openfold3| RANK_PREDICTIONS
